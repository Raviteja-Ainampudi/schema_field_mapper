# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here has a working default except the AWS credentials, which are
# only needed for live Bedrock runs. `--offline` runs need none of this.

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bedrock model IDs per pipeline role. Validate them with:
#   python scripts/check_bedrock.py
BEDROCK_ROUTER_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_MAPPER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_CHEAP_MAPPER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Feature flags
ENABLE_EMBEDDINGS=false
ENABLE_RESPONSE_CACHE=true
ENABLE_CASCADE=true
ENABLE_REFLECTION=true

# Guardrails
MAX_TOKENS_PER_RUN=120000

# Shared-demo protection for the deployed Function URL. Empty disables the check.
APP_ACCESS_TOKEN=

LOG_LEVEL=INFO
